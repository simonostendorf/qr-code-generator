# The build output is plain HTML, JS and CSS, so it is built once on the
# build platform and shared by every target platform.
FROM --platform=$BUILDPLATFORM docker.io/library/node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build

WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.30.5-alpine3.24@sha256:ed04ec1ff34502c339ee5c3ae3f855442398edc1d05591e2b98981dcbbd20b1e

LABEL org.opencontainers.image.source="https://github.com/simonostendorf/qr-code-generator" \
      org.opencontainers.image.title="qr-code-generator-frontend" \
      org.opencontainers.image.description="Web interface of the QR code generator, served by nginx, which proxies /api/ to the backend"

# Rendered into /etc/nginx/conf.d/default.conf at start; only BACKEND_URL is
# substituted, nginx variables stay as they are.
ENV BACKEND_URL=http://backend:8000 \
    NGINX_ENVSUBST_FILTER=BACKEND_URL

COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist/ /usr/share/nginx/html/

EXPOSE 8080
